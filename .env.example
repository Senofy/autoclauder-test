# Copy to .env and fill in. Anything already exported wins over this file, so
# `CLAUDE_DISPLAY=2 python3 agent.py ...` still overrides for one run.
#
#   cp .env.example .env

ANTHROPIC_API_KEY=sk-ant-...

# Optional -- point at a gateway or proxy instead of the public API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Which display to capture, 1-based. Not X11's DISPLAY; this is the monitor.
# CLAUDE_DISPLAY=1

# Force a backend instead of guessing from the platform: macos or x11.
# CLAUDE_BACKEND=x11

# Linux only: which X server to drive. Needed when running from a session that
# has no DISPLAY of its own, e.g. over ssh or under Xvfb.
# DISPLAY=:0
